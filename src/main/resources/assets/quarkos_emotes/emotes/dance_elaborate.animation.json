  "quarkos": {
    "id": "quarkos_emotes:dance_elaborate",
    "name": "emote.quarkos_emotes.dance_elaborate",
    "icon": "minecraft:music_disc_cat",
    "category": "dance",
    "cancel_on_move": true,
    "easing": "linear",
    "notes": "Eight-second dance at 120 BPM: step-touch, sequential arm waves, one unwrapped 0-to-360 body-Y spin, then hip sway. Sibling bones carry matching Y turns; do not inherit body rotation again. Last Y=360 is visually equal to first Y=0; do not shortest-path-normalize this turn. Linear keys preserve the spin direction. Arm and leg position channels orbit their Steve pivots around the body origin during the turn; preview attachment on slim rigs separately."
  }
